    "GoalInput":{"additionalProperties":false,"description":"A target with its ordered local context, elaborated by the provider.","properties":{"kind":{"const":"goal","title":"Kind","type":"string"},"goal_text":{"maxLength":20000,"minLength":1,"title":"Goal Text","type":"string"},"hypotheses":{"items":{"maxLength":20000,"minLength":1,"type":"string"},"maxItems":512,"title":"Hypotheses","type":"array"},"universe_levels":{"items":{"pattern":"^[A-Za-z_][A-Za-z0-9_]*$","type":"string"},"maxItems":64,"title":"Universe Levels","type":"array"}},"required":["kind","goal_text","hypotheses","universe_levels"],"title":"GoalInput","type":"object"},
    "ModelBundle":{"additionalProperties":false,"properties":{"tactic_model_artifact":{"anyOf":[{"pattern":"^sha256:[0-9a-f]{64}$","type":"string"},{"type":"null"}],"default":null,"title":"Tactic Model Artifact"},"argument_model_artifact":{"anyOf":[{"pattern":"^sha256:[0-9a-f]{64}$","type":"string"},{"type":"null"}],"default":null,"title":"Argument Model Artifact"},"premise_model_artifact":{"anyOf":[{"pattern":"^sha256:[0-9a-f]{64}$","type":"string"},{"type":"null"}],"default":null,"title":"Premise Model Artifact"}},"title":"ModelBundle","type":"object"},
    "SearchPolicy":{"additionalProperties":false,"properties":{"policy_name":{"anyOf":[{"maxLength":128,"type":"string"},{"type":"null"}],"default":null,"title":"Policy Name"},"deny_sorry":{"const":true,"title":"Deny Sorry","type":"boolean"}},"required":["deny_sorry"],"title":"SearchPolicy","type":"object"},
    "SourceInput":{"additionalProperties":false,"description":"A declaration in a caller-supplied source artifact.\n\nThe provider resolves the artifact by content hash, elaborates the named\ndeclaration's signature in its original context, and searches it with the\ndeclaration's outer binders introduced. The declaration's own proof is\nnever used and the declaration is never offered as a premise.","properties":{"kind":{"const":"source","title":"Kind","type":"string"},"artifact_hash":{"pattern":"^sha256:[0-9a-f]{64}$","title":"Artifact Hash","type":"string"},"declaration":{"maxLength":512,"minLength":1,"pattern":"^[^\\s.][^\\s]*$","title":"Declaration","type":"string"},"starting_state":{"const":"binders-introduced","title":"Starting State","type":"string"}},"required":["kind","artifact_hash","declaration","starting_state"],"title":"SourceInput","type":"object"},
    "FormalSearchRequest":{"additionalProperties":false,"properties":{"protocol_version":{"const":2,"title":"Protocol Version","type":"integer"},"proof_id":{"minLength":1,"title":"Proof Id","type":"string"},"claim_id":{"pattern":"^[^/]+/c-[1-9][0-9]*$","title":"Claim Id","type":"string"},"formal_declaration_id":{"pattern":"^[^/]+/fd-[1-9][0-9]*$","title":"Formal Declaration Id","type":"string"},"run_id":{"pattern":"^[^/]+/fr-[1-9][0-9]*$","title":"Run Id","type":"string"},"base_revision":{"minimum":0,"title":"Base Revision","type":"integer"},"lease_id":{"title":"Lease Id","type":"string"},"fencing_token":{"minimum":1,"title":"Fencing Token","type":"integer"},"input":{"discriminator":{"mapping":{"goal":"#/$defs/GoalInput","source":"#/$defs/SourceInput"},"propertyName":"kind"},"oneOf":[{"$ref":"#/$defs/SourceInput"},{"$ref":"#/$defs/GoalInput"}],"title":"Input"},"environment_id":{"minLength":1,"title":"Environment Id","type":"string"},"environment_hash":{"pattern":"^sha256:[0-9a-f]{64}$","title":"Environment Hash","type":"string"},"backend":{"anyOf":[{"$ref":"#/$defs/BackendSelection"},{"type":"null"}],"default":null},"deployment_id":{"anyOf":[{"maxLength":256,"minLength":1,"type":"string"},{"type":"null"}],"default":null,"title":"Deployment Id"},"search_policy":{"$ref":"#/$defs/SearchPolicy"},"budget":{"$ref":"#/$defs/Budget"},"corpus_manifest":{"anyOf":[{"$ref":"#/$defs/CorpusManifest"},{"type":"null"}],"default":null},"model_bundle":{"anyOf":[{"$ref":"#/$defs/ModelBundle"},{"type":"null"}],"default":null}},"required":["protocol_version","proof_id","claim_id","formal_declaration_id","run_id","base_revision","lease_id","fencing_token","input","environment_id","environment_hash","search_policy","budget"],"title":"FormalSearchRequest","type":"object"},
    "VerificationBudget":{"additionalProperties":false,"properties":{"max_steps":{"minimum":1,"title":"Max Steps","type":"integer"},"wall_clock_ms":{"anyOf":[{"minimum":1,"type":"integer"},{"type":"null"}],"default":null,"title":"Wall Clock Ms"}},"required":["max_steps"],"title":"VerificationBudget","type":"object"},
    "FormalReplayRequest":{"additionalProperties":false,"description":"Independent replay of a run's stored certificate, bound to its evidence.","properties":{"protocol_version":{"const":2,"title":"Protocol Version","type":"integer"},"run_id":{"pattern":"^[^/]+/fr-[1-9][0-9]*$","title":"Run Id","type":"string"},"certificate_hash":{"pattern":"^sha256:[0-9a-f]{64}$","title":"Certificate Hash","type":"string"},"input_artifact_hash":{"pattern":"^sha256:[0-9a-f]{64}$","title":"Input Artifact Hash","type":"string"},"source_artifact_hash":{"pattern":"^sha256:[0-9a-f]{64}$","title":"Source Artifact Hash","type":"string"},"environment_hash":{"pattern":"^sha256:[0-9a-f]{64}$","title":"Environment Hash","type":"string"},"budget":{"$ref":"#/$defs/VerificationBudget"}},"required":["protocol_version","run_id","certificate_hash","input_artifact_hash","source_artifact_hash","environment_hash","budget"],"title":"FormalReplayRequest","type":"object"},
