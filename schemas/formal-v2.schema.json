  "$defs": {
    "BackendSelection":{"additionalProperties":false,"properties":{"name":{"enum":["mcts-actor-critic","accepted-gnn"],"title":"Name","type":"string"},"profile":{"maxLength":128,"minLength":1,"title":"Profile","type":"string"},"proposal_mode":{"anyOf":[{"enum":["sample","greedy"],"type":"string"},{"type":"null"}],"default":null,"title":"Proposal Mode"},"seed":{"anyOf":[{"maximum":9223372036854775807,"minimum":0,"type":"integer"},{"type":"null"}],"default":null,"title":"Seed"}},"required":["name","profile"],"title":"BackendSelection","type":"object"},
    "Budget":{"additionalProperties":false,"properties":{"max_steps":{"minimum":1,"title":"Max Steps","type":"integer"},"wall_clock_ms":{"anyOf":[{"minimum":1,"type":"integer"},{"type":"null"}],"default":null,"title":"Wall Clock Ms"}},"required":["max_steps"],"title":"Budget","type":"object"},
