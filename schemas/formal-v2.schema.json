    "FormalResult":{"additionalProperties":false,"description":"Versioned evidence envelope; graph rows retain the canonical graph contract.\n\nConsumers must additionally validate graph structure and complete AND-child\nobligations. Envelope validation alone cannot establish proof closure.","properties":{"protocol_version":{"const":2,"title":"Protocol Version","type":"integer"},"run_id":{"pattern":"^[^/]+/fr-[1-9][0-9]*$","title":"Run Id","type":"string"},"proof_id":{"title":"Proof Id","type":"string"},"declaration_id":{"title":"Declaration Id","type":"string"},"environment_hash":{"pattern":"^sha256:[0-9a-f]{64}$","title":"Environment Hash","type":"string"},"disposition":{"enum":["searching","proved-pending-replay","budget-exhausted","stagnated","counterexample","invalid-request","environment-error","internal-error","cancelled"],"title":"Disposition","type":"string"},"termination":{"$ref":"#/$defs/ResultTermination"},"root_state_id":{"title":"Root State Id","type":"string"},"states":{"items":{"additionalProperties":true,"type":"object"},"title":"States","type":"array"},"tactic_edges":{"items":{"additionalProperties":true,"type":"object"},"title":"Tactic Edges","type":"array"},"obstructions":{"items":{"additionalProperties":true,"type":"object"},"title":"Obstructions","type":"array"},"artifacts":{"items":{"additionalProperties":true,"type":"object"},"title":"Artifacts","type":"array"},"budget_used":{"$ref":"#/$defs/ResultUsage"},"budget":{"$ref":"#/$defs/ResultBudget"},"input_kind":{"enum":["source","goal"],"title":"Input Kind","type":"string"},"input_artifact_hash":{"anyOf":[{"pattern":"^sha256:[0-9a-f]{64}$","type":"string"},{"type":"null"}],"title":"Input Artifact Hash"},"source_artifact_hash":{"anyOf":[{"pattern":"^sha256:[0-9a-f]{64}$","type":"string"},{"type":"null"}],"title":"Source Artifact Hash"},"source_origin":{"anyOf":[{"enum":["caller-artifact","generated-from-text"],"type":"string"},{"type":"null"}],"title":"Source Origin"},"backend":{"$ref":"#/$defs/ResultBackend"},"request_digest":{"pattern":"^sha256:[0-9a-f]{64}$","title":"Request Digest","type":"string"},"coordinator_binding":{"$ref":"#/$defs/CoordinatorBinding"},"attempts":{"minimum":0,"title":"Attempts","type":"integer"},"certificate":{"anyOf":[{"$ref":"#/$defs/ResultCertificate"},{"type":"null"}],"default":null}},"required":["protocol_version","run_id","proof_id","declaration_id","environment_hash","disposition","termination","root_state_id","states","tactic_edges","obstructions","artifacts","budget_used","budget","input_kind","input_artifact_hash","source_artifact_hash","source_origin","backend","request_digest","coordinator_binding","attempts"],"title":"FormalResult","type":"object"},
