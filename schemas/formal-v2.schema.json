    "Admission":{"additionalProperties":false,"description":"The admission acknowledgement: the run's effective settings and identities.","properties":{"protocol_version":{"const":2,"default":2,"title":"Protocol Version","type":"integer"},"run_id":{"title":"Run Id","type":"string"},"status":{"enum":["admitting","queued","running","cancelling","finished","interrupted"],"title":"Status","type":"string"},"request_digest":{"pattern":"^sha256:[0-9a-f]{64}$","title":"Request Digest","type":"string"},"input_kind":{"enum":["source","goal"],"title":"Input Kind","type":"string"},"input_artifact_hash":{"anyOf":[{"pattern":"^sha256:[0-9a-f]{64}$","type":"string"},{"type":"null"}],"title":"Input Artifact Hash"},"source_artifact_hash":{"anyOf":[{"pattern":"^sha256:[0-9a-f]{64}$","type":"string"},{"type":"null"}],"title":"Source Artifact Hash"},"source_origin":{"anyOf":[{"enum":["caller-artifact","generated-from-text"],"type":"string"},{"type":"null"}],"title":"Source Origin"},"resolved":{"$ref":"#/$defs/ResolvedDeployment"},"budget":{"$ref":"#/$defs/AdmittedBudget"},"attempts":{"title":"Attempts","type":"integer"},"retry_from":{"const":"bound-initial-input","default":"bound-initial-input","title":"Retry From","type":"string"}},"required":["run_id","status","request_digest","input_kind","input_artifact_hash","source_artifact_hash","source_origin","resolved","budget","attempts"],"title":"Admission","type":"object"},
    "ReplayAttestation":{"additionalProperties":false,"properties":{"protocol_version":{"const":2,"default":2,"title":"Protocol Version","type":"integer"},"status":{"enum":["verified","rejected","inconclusive"],"title":"Status","type":"string"},"reason":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Reason"},"run_id":{"title":"Run Id","type":"string"},"certificate_hash":{"pattern":"^sha256:[0-9a-f]{64}$","title":"Certificate Hash","type":"string"},"input_artifact_hash":{"pattern":"^sha256:[0-9a-f]{64}$","title":"Input Artifact Hash","type":"string"},"source_artifact_hash":{"pattern":"^sha256:[0-9a-f]{64}$","title":"Source Artifact Hash","type":"string"},"source_origin":{"enum":["caller-artifact","generated-from-text"],"title":"Source Origin","type":"string"},"environment_hash":{"title":"Environment Hash","type":"string"},"backend":{"enum":["mcts-actor-critic","accepted-gnn"],"title":"Backend","type":"string"},"verification_cost":{"additionalProperties":true,"title":"Verification Cost","type":"object"}},"required":["status","run_id","certificate_hash","input_artifact_hash","source_artifact_hash","source_origin","environment_hash","backend","verification_cost"],"title":"ReplayAttestation","type":"object"},
