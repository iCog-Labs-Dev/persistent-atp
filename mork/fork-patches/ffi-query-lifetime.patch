+// Kernel serializers unwrap write errors. A capped sink must therefore keep
+// accepting writes after overflow, discard them, and report the typed limit
+// error after serialization rather than panicking and poisoning the Space.
+struct LimitedWriter<'a> {
+    buf: &'a mut Vec<u8>,
+    limit: usize,
+    exceeded: bool,
+}
+impl std::io::Write for LimitedWriter<'_> {
+    fn write(&mut self, chunk: &[u8]) -> std::io::Result<usize> {
+        if self.exceeded || chunk.len() > self.limit.saturating_sub(self.buf.len()) {
+            self.exceeded = true;
