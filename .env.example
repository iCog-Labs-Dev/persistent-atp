NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here
NEO4J_DATABASE=neo4j
ARTIFACT_DB_URL=postgresql://user:password@localhost:5432/artifacts
ARTIFACT_TEST_DB_URL=postgresql://user:password@localhost:5432/artifacts_test

# Omega bridge: trusted receiver configuration, never model-facing arguments.
PERSISTENT_ATP_OMEGA_URL=http://127.0.0.1:8765
PERSISTENT_ATP_OMEGA_TOKEN=replace-with-a-long-random-token
PERSISTENT_ATP_OMEGA_WORKSPACE=reference
# Trusted host default; in Omega's sandbox use its writable memory directory.
# The Docker image defaults to /PeTTa/repos/Omega/memory/persistent_atp/workflow.json.
PERSISTENT_ATP_OMEGA_STATE=.runs/omega-state.json
PERSISTENT_ATP_OMEGA_MAX_CYCLES=10
PERSISTENT_ATP_OMEGA_RETRY_LIMIT=4
PERSISTENT_ATP_OMEGA_RETRY_BASE_SECONDS=0.5
# Enable the plugin in Omega's own configuration (disabled by default).
OMEGA_persistentAtpEnabled=enabled
OMEGA_persistentAtpWorkspace=reference
# Exact Omega revision: ba185cd359d9fe231b904110b988af39fafa5014
OMEGA_PINNED_ROOT=tmp/repos/Omega-ba185cd
PETTA_PINNED_ROOT=tmp/repos/PeTTa
# Set an absolute Python >=3.11 interpreter that can import janus_swi.
# PETTA_PYTHON=/absolute/path/to/persistent-atp/.venv/bin/python
# Janus launcher: auto, python (host), or swipl (official container).
OMEGA_JANUS_MODE=auto
# Trusted proxy credentials; select only the providers you use.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
ASIONE_API_KEY=
# ASI OpenAI-compatible endpoint and model (key must belong to this endpoint).
ASIONE_BASE_URL=https://llm.a.singularitycompute.com/v1
ASIONE_MODEL=asi1-mini
# Native MORK library, preloaded by scripts/with-mork.sh.
# MORK_LIBRARY=/absolute/path/to/libmork_ffi.so
# Formalizer API: configure one provider in your local .env file.
# OPENAI_API_KEY=your_key_here
# LLM_MODEL=your_model_name
# LLM_ENDPOINT_URL=https://api.openai.com/v1/chat/completions
# GEMINI_API_KEY=your_key_here
# GEMINI_MODEL=your_model_name

# Trusted formal-v2 provider (PR95); credentials never reach Omega tools.
# Enable with: persistent-atp-omega serve --config formal
PERSISTENT_ATP_FORMAL_URL=http://127.0.0.1:39743
PERSISTENT_ATP_FORMAL_DEPLOYMENT=
PERSISTENT_ATP_FORMAL_PROFILE=
PERSISTENT_ATP_FORMAL_TOKEN=
PERSISTENT_ATP_FORMAL_MAX_STEPS=100
PERSISTENT_ATP_FORMAL_WALL_CLOCK_MS=30000
PERSISTENT_ATP_FORMAL_REPLAY_STEPS=128
PERSISTENT_ATP_FORMAL_REPLAY_WALL_CLOCK_MS=60000
PERSISTENT_ATP_FORMAL_HTTP_TIMEOUT=90
# Optional provider checkout for contract tests when not installed as a package.
# PERSISTENT_ATP_FORMAL_SOURCE=/absolute/path/to/Mathematics-ai-atp

# Standalone live Omega capability playground (uses the selected provider key).
OMEGA_PLAYGROUND_IMAGE=persistent-atp-omega:playground
OMEGA_PLAYGROUND_BASE_IMAGE=singularitynet/omega@sha256:a258d30a92b58b8b4bc104605ee57f20b2c2527b2a9ac3532186057098619f3b
OMEGA_PLAYGROUND_SOURCE=tmp/repos/Omega-ba185cd
OMEGA_PLAYGROUND_PROVIDER=DeepSeek
# Set OMEGA_PLAYGROUND_PROVIDER=ASIOne to use ASIONE_* above.
# Empty uses DEEPSEEK_MODEL or ASIONE_MODEL for the selected provider.
OMEGA_PLAYGROUND_MODEL=
OMEGA_PLAYGROUND_OUTPUT=.runs/omega-capabilities
OMEGA_PLAYGROUND_TIMEOUT=120
OMEGA_PLAYGROUND_STARTUP_TIMEOUT=300
