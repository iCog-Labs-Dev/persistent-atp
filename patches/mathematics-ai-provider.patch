+def test_all_lean_children_survive_ranking_in_original_order():
+    from maths_ai.data_models.proof_components import Goal, RankedSubgoal, STV
+    from maths_ai.hybrid_reasoner.hypergraph import ProofHypergraph, TacticOutcome
+    from maths_ai.hybrid_reasoner.joint_inference import HybridReasoner
+    reasoner = HybridReasoner.__new__(HybridReasoner)
+    reasoner.max_depth, reasoner.top_k_subgoals = 10, 3
+    reasoner.max_steps, reasoner.tactic_steps = None, 0
+    goals = [Goal(expression=f"P{i}", hypotheses=[f"h{i} : P{i}"]) for i in range(4)]
+    async def start(_): return object()
+    async def apply(*_): return TacticOutcome(success=True, subgoals=goals)
+    reasoner.server = object()
+    reasoner._start_state = start
+    reasoner.executor = SimpleNamespace(apply=apply)
+    reasoner.predict_next_tactic = lambda _: [TacticCandidate(tactic_name="constructor", arguments=[], probability=1)]
+    reasoner.rank_subgoals = lambda *a, **kw: [RankedSubgoal(goal=goal, stv=STV(strength=.9, confidence=1),
+                                              gnn_probability=1) for goal in reversed(goals)]
+    graph = ProofHypergraph(Goal(expression="P"))
+    asyncio.run(reasoner._expand(graph, graph.root))
+    edge = next(iter(graph.edges.values()))
+    assert [graph.nodes[child].goal for child in edge.child_ids] == goals
+    assert not graph.is_solved()
+    assert graph.summary()["nodes"][1]["hypotheses"] == ["h0 : P0"]
+
+
