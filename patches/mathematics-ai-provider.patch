+from maths_ai.api.tests.test_api import FakeReasoner, SOLVED_TRACE
+
+
+@pytest.fixture
+def provider(tmp_path, monkeypatch):
+    manifest = {"lean_version": "explicit-test-fixture", "project_files": {"Main.lean": "fixture"}}
+    service = InferenceService(reasoner=FakeReasoner(), backend_mode="real", dts_state_path=tmp_path / "dts.json")
+    service.environment_manifest = manifest
+    monkeypatch.setattr("maths_ai.api.service.environment_manifest", lambda _: dict(manifest))
+    async def factory(): return service
+    async def replay(*_): return {"status": "verified", "verified": True}
+    service.replay = replay
+    with TestClient(create_app(service_factory=factory, formal_runs_dir=tmp_path / "runs")) as client:
+        yield client, service, manifest
+
+
+def envelope(manifest):
+    return {"run_id": "p/fr-1", "problem": {"goal": "Or q p", "hypotheses": ["h : Or p q"]},
+        "environment": {"variables": {"persistent_atp_environment_hash": digest(canonical_bytes(manifest))}},
+        "budget": {"max_steps": 3, "timeout": 5}}
+
+
+def test_identical_start_is_idempotent_and_changed_body_is_rejected(provider):
+    client, service, manifest = provider
+    request = envelope(manifest)
+    assert client.post("/formal-search/start", json=request).status_code == 202
+    assert client.post("/formal-search/start", json=request).status_code == 202
+    changed = {**request, "problem": {"goal": "False"}}
+    assert client.post("/formal-search/start", json=changed).status_code == 422
+    assert len(service.reasoner.prove_calls) == 1
+
+
+def test_environment_is_measured_and_bound_replay_is_attested(provider):
+    client, service, manifest = provider
+    request = envelope(manifest)
+    caps = client.get("/capabilities").json()
+    assert caps["environment_hash"] == request["environment"]["variables"]["persistent_atp_environment_hash"]
+    wrong = {**request, "environment": {"variables": {"persistent_atp_environment_hash": "sha256:" + "0" * 64}}}
+    assert client.post("/formal-search/start", json=wrong).status_code == 422
+    assert client.post("/formal-search/start", json=request).status_code == 202
+    payload = {"run_id": request["run_id"], "problem": request["problem"], "proof_trace": SOLVED_TRACE,
+               "certificate_hash": digest(canonical_bytes(SOLVED_TRACE))}
+    response = client.post("/formal-replay", json=payload)
+    assert response.status_code == 200, response.text
+    result = response.json()
+    assert result["verified"] is True and result["sorry_detected"] is False
+    assert result["certificate_hash"] == payload["certificate_hash"]
+    assert result["environment_hash"] == caps["environment_hash"]
+    assert result["run_id"] == request["run_id"]
+
+
+def test_drift_during_replay_cannot_mark_run_verified(provider):
+    client, service, manifest = provider
+    request = envelope(manifest)
+    assert client.post("/formal-search/start", json=request).status_code == 202
+    async def drift(*_):
+        manifest["lean_version"] = "different"
+        return {"verified": True, "status": "verified"}
+    service.replay = drift
+    response = client.post("/formal-replay", json={"run_id": request["run_id"],
+        "problem": request["problem"], "proof_trace": SOLVED_TRACE})
+    assert response.json()["verified"] is False
+
+
+def test_atomic_write_failure_preserves_the_previous_record(tmp_path, monkeypatch):
+    target = tmp_path / "run.json"
+    atomic_json(target, {"status": "found"})
+    def fail(*_): raise OSError("simulated replacement failure")
+    monkeypatch.setattr(Path, "replace", fail)
+    with pytest.raises(OSError): atomic_json(target, {"status": "verified"})
+    assert json.loads(target.read_text()) == {"status": "found"}
+    assert len(list(tmp_path.iterdir())) == 1
+
+
+def test_run_directory_has_one_owner_and_restart_keeps_original_request(tmp_path):
+    service = InferenceService(reasoner=FakeReasoner())
+    manager = FormalSearchManager(service, tmp_path)
+    with pytest.raises(RuntimeError, match="another service"):
+        FormalSearchManager(service, tmp_path)
+    request = {"run_id": "p/fr-1", "problem": {"goal": "True"}}
+    from maths_ai.api.service import FormalRun
+    manager._save(FormalRun(run_id="p/fr-1", envelope=request, status="running"))
+    manager.close()
+    restored = FormalSearchManager(service, tmp_path)
+    try:
+        snapshot = asyncio.run(restored.get("p/fr-1"))
+        assert snapshot["status"] == "interrupted" and snapshot["request"] == request
+        assert asyncio.run(restored.start(request))["status"] == "interrupted"
+        assert restored.runs["p/fr-1"].task is None
+    finally: restored.close()
+
+
+def test_real_lean_compilation_and_axiom_audit(tmp_path, monkeypatch):
+    toolchain = os.environ.get("MATHS_AI_TEST_LEAN_TOOLCHAIN")
+    if not toolchain: pytest.skip("set MATHS_AI_TEST_LEAN_TOOLCHAIN to an installed Lean toolchain")
+    (tmp_path / "lean-toolchain").write_text(toolchain + "\n")
+    (tmp_path / "lakefile.toml").write_text('name = "replaytest"\nversion = "0.1.0"\n')
+    (tmp_path / "lake-manifest.json").write_text('{"version":"1.1.0","packages":[]}')
+    monkeypatch.setattr("maths_ai.api.service.settings", SimpleNamespace(lean_project_path=tmp_path))
+    manifest = environment_manifest(tmp_path)
+    assert "Lean" in manifest["lean_version"]
+    InferenceService._verify_declaration_sync("True", {"tactic": "exact", "arguments": ["True.intro"], "subgoals": []}, [])
+    with pytest.raises(ValueError):
+        InferenceService._verify_declaration_sync("False", {"tactic": "exact", "arguments": ["True.intro"], "subgoals": []}, [])
+    with pytest.raises(ValueError, match="placeholders"):
+        InferenceService._verify_declaration_sync("False", {"tactic": "sorry", "arguments": [], "subgoals": []}, [])
+
+
+def test_optional_backend_token_protects_execution_and_capabilities(tmp_path, monkeypatch):
+    monkeypatch.setenv("MATHS_AI_API_TOKEN", "backend-test-token-123456")
+    async def factory(): return InferenceService(reasoner=FakeReasoner())
+    with TestClient(create_app(service_factory=factory, formal_runs_dir=tmp_path)) as client:
+        assert client.get("/health").status_code == 200
+        assert client.get("/capabilities").status_code == 401
+        assert client.post("/prove", json={"goal": "True"}).status_code == 401
+        result = client.get("/capabilities", headers={"Authorization": "Bearer backend-test-token-123456"})
+        assert result.status_code == 200 and result.json()["backend_mode"] == "test-only"
