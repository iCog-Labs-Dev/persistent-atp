; Proof catalogue: string-argument tools. No workers call MeTTa.
; The loader imports into this plugin's space on every reload. Remove old
; function definitions as well as catalogue entries, so one tool call cannot
; execute several compiled copies of the wrapper.
!(collapse (match &plugin-persistent_atp (= $signature $body)
   (remove-atom &plugin-persistent_atp (= $signature $body))))

; Restore declarations before compiling callbacks and wrapper bodies.
!(import_prolog_function proof-create)
!(import_prolog_function proof-cycle)
!(import_prolog_function proof-status)
!(import_prolog_function proof-audit)
!(import_prolog_function proof-export)
!(import_prolog_function formal-search)
!(import_prolog_function formal-resume)
!(import_prolog_function statement-align)
!(import_prolog_function lemma-bridge)
!(import_prolog_function hypothesis-formalize)
!(import_prolog_function hypothesis-revise)
!(import_prolog_function persistent-atp-collect-results)

(= (loadOmegaPlugin)
   (let* (($enabled (configGetByKey persistentAtpEnabled disabled))
          ($workspace (configGetByKey persistentAtpWorkspace reference)))
   (progn
      (remove-prompt-extension persistent-atp-policy)
      (add-prompt-extension persistent-atp-policy
         (py-call (omega_persistent_atp_bridge.reporting_policy)))
      (remove-heartbeat-listener persistent_atp)
      (if (== $enabled enabled)
         (progn
            (py-call (omega_persistent_atp_bridge.startup $workspace))
            (add-skill proof-create "Create a proof from complete JSON theorem, definitions, assumptions, domains, background, targets and verification policy. Returns bridge dispatch identity; durable admission and results arrive later." (spec workspace))
            (add-skill proof-cycle "Request one bounded proof cycle. Admission is not proof completion." (proof workspace))
            (add-skill proof-status "Read authoritative literal-target status; result arrives asynchronously." (proof workspace))
            (add-skill proof-audit "Request an integrity audit and retain its operation reference." (proof workspace))
            (add-skill proof-export "Export through an allowlisted destination alias." (proof destination workspace))
            (add-skill formal-search "Request formal search for an authoritative claim with bounded JSON budget." (proof claim budget workspace))
            (add-skill formal-resume "Continue only when durable checkpoint resume is advertised; never silently restart." (proof run budget workspace))
            (add-skill statement-align "Review a claim against an authorized Lean source artifact hash, never a filename or URL." (proof claim lean_source workspace))
            (add-skill lemma-bridge "Request speculative invention linked to the exact obstruction." (proof obstruction workspace))
            (add-skill hypothesis-formalize "Formalize one explicitly selected speculative hypothesis at the exact expected revision. Produces a provisional claim and statement review, not a verified lemma." (proof hypothesis expected_revision workspace))
            (add-skill hypothesis-revise "Explicitly refine a suggestion with complete theorem-spec JSON and an exact expected revision. previous_claim is the last provisional attempt ID, or empty if none exists. Creates a separate provisional claim; preserves all earlier attempts." (proof hypothesis spec previous_claim expected_revision workspace))
            (add-heartbeat-listener persistent_atp (|-> ($iter) (persistent-atp-collect-results $iter))))
         (progn
            (remove-skill proof-create)
            (remove-skill proof-cycle)
            (remove-skill proof-status)
            (remove-skill proof-audit)
            (remove-skill proof-export)
            (remove-skill formal-search)
            (remove-skill formal-resume)
            (remove-skill statement-align)
            (remove-skill lemma-bridge)
            (remove-skill hypothesis-formalize)
            (remove-skill hypothesis-revise)
            (py-call (omega_persistent_atp_bridge.disable))))
      ())))

(= (persistent-atp-collect-results $iteration)
   (let $results (py-call (omega_persistent_atp_bridge.take_completed))
      (if (> (string_length $results) 0)
         (let $receipt
            (append-file
               (joinPath ((projectRootDirectory) "memory" "history.metta"))
               (swrite ((get_time_as_string) (newline) $results (newline))))
            (py-call (omega_persistent_atp_bridge.ack_completed $results $receipt)))
         ())))

(= (proof-create $spec $workspace)
   (py-call (omega_persistent_atp_bridge.proof_create $spec $workspace)))
(= (proof-cycle $proof $workspace)
   (py-call (omega_persistent_atp_bridge.proof_cycle $proof $workspace)))
(= (proof-status $proof $workspace)
   (py-call (omega_persistent_atp_bridge.proof_status $proof $workspace)))
(= (proof-audit $proof $workspace)
   (py-call (omega_persistent_atp_bridge.proof_audit $proof $workspace)))
(= (proof-export $proof $destination $workspace)
   (py-call (omega_persistent_atp_bridge.proof_export $proof $destination $workspace)))
(= (formal-search $proof $claim $budget $workspace)
   (py-call (omega_persistent_atp_bridge.formal_search $proof $claim $budget $workspace)))
(= (formal-resume $proof $run $budget $workspace)
   (py-call (omega_persistent_atp_bridge.formal_resume $proof $run $budget $workspace)))
(= (statement-align $proof $claim $lean_source $workspace)
   (py-call (omega_persistent_atp_bridge.statement_align $proof $claim $lean_source $workspace)))
(= (lemma-bridge $proof $obstruction $workspace)
   (py-call (omega_persistent_atp_bridge.lemma_bridge $proof $obstruction $workspace)))
(= (hypothesis-formalize $proof $hypothesis $expected_revision $workspace)
   (py-call (omega_persistent_atp_bridge.hypothesis_formalize $proof $hypothesis $expected_revision $workspace)))
(= (hypothesis-revise $proof $hypothesis $spec $previous_claim $expected_revision $workspace)
   (py-call (omega_persistent_atp_bridge.hypothesis_revise $proof $hypothesis $spec $previous_claim $expected_revision $workspace)))
