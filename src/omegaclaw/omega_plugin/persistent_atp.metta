; Capability-limited Omega plugin. All arguments remain strings in providers.py.
(= (loadOmegaPlugin)
   (progn
      (add-skill proof-create "Create a persistent proof from a JSON spec string" (spec workspace))
      (add-skill proof-cycle "Execute one bounded persistent proof cycle" (proof workspace))
      (add-skill proof-status "Read authoritative proof status" (proof workspace))
      (add-skill proof-audit "Audit journal and artifact integrity" (proof workspace))
      (add-skill proof-export "Export a proof to an allowlisted destination" (proof destination workspace))
      (add-skill formal-search "Start formal search with a JSON budget string" (proof claim budget workspace))
      (add-skill formal-resume "Resume a durable formal run with a JSON budget string" (proof run budget workspace))
      (add-skill statement-align "Review a claim against a saved Lean source artifact" (proof claim lean_source workspace))
      (add-skill lemma-bridge "Seek a bounded speculative bridge for an obstruction" (proof obstruction workspace))
      (remove-prompt-extension persistent-atp-policy)
      (add-prompt-extension persistent-atp-policy "Proof status comes only from the persistent-atp service. Scores and research reviews are not formal proof. Formal completion requires independent Lean replay. A failed or timed-out tool call is not success.")
      ()))

(= (proof-create $spec $workspace)
   (py-call (omega_persistent_atp_bridge.proof_create $spec $workspace)))
(= (proof-cycle $proof $workspace)
   (py-call (omega_persistent_atp_bridge.proof_cycle $proof $workspace)))
(= (proof-status $proof $workspace)
   (py-call (omega_persistent_atp_bridge.proof_status $proof $workspace)))
(= (proof-audit $proof $workspace)
   (py-call (omega_persistent_atp_bridge.proof_audit $proof $workspace)))
(= (proof-export $proof $destination $workspace)
   (py-call (omega_persistent_atp_bridge.proof_export $proof $destination $workspace)))
(= (formal-search $proof $claim $budget $workspace)
   (py-call (omega_persistent_atp_bridge.formal_search $proof $claim $budget $workspace)))
(= (formal-resume $proof $run $budget $workspace)
   (py-call (omega_persistent_atp_bridge.formal_resume $proof $run $budget $workspace)))
(= (statement-align $proof $claim $lean_source $workspace)
   (py-call (omega_persistent_atp_bridge.statement_align $proof $claim $lean_source $workspace)))
(= (lemma-bridge $proof $obstruction $workspace)
   (py-call (omega_persistent_atp_bridge.lemma_bridge $proof $obstruction $workspace)))
